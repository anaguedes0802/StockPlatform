# Backend
DATABASE_URL=postgresql+psycopg://stockplatform:stockplatform@localhost:5432/stockplatform
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
CORS_ORIGINS=http://localhost:3000
ENV=dev

# Market data providers (yfinance needs no key)
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# News / sentiment (optional)
NEWSAPI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# Optional AI chat / opinion agent.
#
# IMPORTANT: This is the **Anthropic API** (console.anthropic.com), NOT your
# claude.ai Pro/Max subscription. Those are separately billed products.
# Get a key at: https://console.anthropic.com → Settings → API Keys
# Pricing as of 2026: Sonnet $3/$15 per M tokens, Haiku $0.80/$4, Opus $15/$75
ANTHROPIC_API_KEY=

ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET=YOUR_LONG_SECRET_HERE

# Model used by /ai/opinion and /ai/chat. Defaults to claude-sonnet-4-6.
# Options: claude-haiku-4-5 (cheap, fast), claude-sonnet-4-6 (default),
#          claude-opus-4-7  (highest quality, most expensive)
LLM_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=

# ---------- swing trading: daily bot auto-run (opt-in) ----------
# When 1, every ARMED + ACTIVE trader bot whose execution.autorun is true runs
# once per US trading day at BOT_AUTORUN_ET (New York time). Alpaca bots trade
# whatever endpoint alpaca_trading_base_url points at (paper by default);
# "sim" bots trade their own simulated ledger. Without the server running,
# scripts/run_paper_bots.py does the same pass (e.g. from cron).
BOT_AUTORUN=0
BOT_AUTORUN_ET=09:45
